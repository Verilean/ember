/-- The items and the layout are those of the image `build` gives without the passes. -/
def isBuilt : Bool :=
  match Codegen.build Crc32.ir Runtime.harness (passes := false) with
  | .ok img => decide (img.items = items) && img.layout.globals == layout.globals &&
      img.layout.frames == layout.frames && img.layout.top == layout.top
  | .error _ => false

